# TriageSync backend environment variables
# Copy these values into backend/.env and replace placeholders.

PORT=5000
NODE_ENV=development

# MySQL database (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/triagesync"

# MongoDB database
MONGODB_URI="mongodb://127.0.0.1:27017/triagesync"

# Authentication: use a random secret with at least 32 characters.
JWT_SECRET="replace-this-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=24h

# Frontend URL
CLIENT_URL="http://localhost:5173"
